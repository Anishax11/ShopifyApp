<div
  class="seasonal-game"
  id="seasonal-game-{{ block.id }}"
  data-theme="none"
>
  <div class="sg-atmosphere" aria-hidden="true"></div>
  <div class="sg-vignette" aria-hidden="true"></div>

  <div class="sg-header">
    <p class="sg-badge">Seasonal Games</p>
    <h2>Spin &amp; Win!</h2>
    <p class="sg-subtitle">Spin the wheel to reveal your reward.</p>
  </div>

  <div class="wheel-container">
    <div class="wheel-halo" aria-hidden="true"></div>
    <div class="wheel-ornaments" aria-hidden="true"></div>
    <div class="pointer" aria-hidden="true">
      <span class="pointer-glow"></span>
      <span class="pointer-art"></span>
    </div>
    <div class="wheel"></div>
    <div class="wheel-hub" aria-hidden="true"></div>
  </div>

  <button type="button" class="spin-button">
    <span class="spin-button-icon" aria-hidden="true"></span>
    <span class="spin-button-label">SPIN</span>
  </button>

  <div class="sg-result" hidden>
    <div class="sg-result-backdrop"></div>
    <div
      class="sg-result-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sg-result-title-{{ block.id }}"
    >
      <div class="sg-result-fx" aria-hidden="true"></div>
      <p class="sg-result-eyebrow"></p>
      <h3 id="sg-result-title-{{ block.id }}" class="sg-result-title"></h3>
      <p class="sg-result-reward"></p>
      <div class="sg-result-code" hidden>
        <span class="sg-result-code-label">Your discount code</span>
        <div class="sg-result-code-row">
          <code class="sg-result-code-value"></code>
          <button type="button" class="sg-copy">Copy</button>
        </div>
      </div>
      <p class="sg-result-hint"></p>
      <button type="button" class="sg-result-close">Spin again</button>
    </div>
  </div>
</div>

<style>
.seasonal-game {
  --game-bg: #14151c;
  --game-bg-2: #2a2438;
  --game-text: #f6f1e8;
  --game-muted: rgba(246, 241, 232, 0.78);
  --game-accent: #e8b86d;
  --game-accent-2: #7c5cbf;
  --game-button-text: #1b140c;
  --game-rim: #f3e6c8;
  --game-hub: #241c14;
  --game-glow: rgba(232, 184, 109, 0.45);
  --pointer-size: 58px;

  position: relative;
  isolation: isolate;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  max-width: 460px;
  margin: 0 auto;
  padding: clamp(22px, 5vw, 36px) clamp(18px, 4vw, 28px) 28px;
  text-align: center;
  color: var(--game-text);
  background:
    radial-gradient(120% 80% at 50% -10%, var(--game-bg-2), transparent 55%),
    var(--game-bg);
  border: 1px solid color-mix(in srgb, var(--game-accent) 35%, transparent);
  border-radius: 28px;
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.12);
  font-family: "Trebuchet MS", "Segoe UI", sans-serif;
}

.seasonal-game *,
.seasonal-game *::before,
.seasonal-game *::after {
  box-sizing: border-box;
}

.sg-atmosphere,
.sg-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: inherit;
}

.sg-vignette {
  z-index: 0;
  background:
    radial-gradient(circle at 12% 18%, var(--game-glow), transparent 28%),
    radial-gradient(circle at 88% 90%, color-mix(in srgb, var(--game-accent-2) 40%, transparent), transparent 32%);
  opacity: 0.9;
}

.sg-atmosphere {
  z-index: 1;
  overflow: hidden;
}

.seasonal-game > .sg-header,
.seasonal-game > .wheel-container,
.seasonal-game > .spin-button,
.seasonal-game > .sg-result {
  position: relative;
  z-index: 2;
}

.sg-header h2 {
  margin: 0 0 8px;
  font-size: clamp(26px, 6vw, 34px);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.04em;
  text-wrap: balance;
}

.sg-subtitle {
  margin: 0;
  font-size: 15px;
  line-height: 1.55;
  color: var(--game-muted);
}

.sg-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: 0 0 12px;
  padding: 5px 12px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--game-accent) 16%, transparent);
  border: 1px solid color-mix(in srgb, var(--game-accent) 45%, transparent);
  color: var(--game-text);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.wheel-container {
  position: relative;
  width: min(300px, 100%);
  aspect-ratio: 1;
  margin: 28px auto 30px;
}

.wheel-halo {
  position: absolute;
  inset: -14px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--game-glow), transparent 68%);
  filter: blur(6px);
  opacity: 0.85;
  animation: sg-halo 4.5s ease-in-out infinite;
}

.wheel-ornaments {
  position: absolute;
  inset: -10px;
  pointer-events: none;
}

.wheel {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  border: 8px solid var(--game-rim);
  border-radius: 50%;
  background:
    radial-gradient(circle at 50% 50%, transparent 57%, rgba(0, 0, 0, 0.2) 58%, transparent 63%),
    conic-gradient(var(--wheel-gradient));
  box-shadow:
    0 0 0 3px color-mix(in srgb, var(--game-accent) 55%, #000),
    0 10px 24px rgba(0, 0, 0, 0.28),
    inset 0 0 0 2px rgba(255, 255, 255, 0.2);
  transition: transform 4s cubic-bezier(0.12, 0.7, 0.18, 1);
  will-change: transform;
}

.wheel-label {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 72px;
  text-align: center;
  transform-origin: 0 0;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0.01em;
  overflow-wrap: break-word;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
}

.wheel-hub {
  position: absolute;
  z-index: 3;
  top: 50%;
  left: 50%;
  width: 22%;
  height: 22%;
  display: grid;
  place-items: center;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  color: var(--game-accent);
  background:
    radial-gradient(circle at 35% 30%, #fff8, transparent 40%),
    var(--game-hub);
  border: 3px solid var(--game-rim);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
}

.wheel-hub svg {
  width: 62%;
  height: 62%;
}

.pointer {
  position: absolute;
  z-index: 4;
  top: -30px;
  left: 50%;
  width: var(--pointer-size);
  height: calc(var(--pointer-size) * 1.25);
  transform: translateX(-50%);
  transform-origin: 50% 18%;
  filter: drop-shadow(0 8px 8px rgba(0, 0, 0, 0.35));
}

.pointer-glow {
  position: absolute;
  inset: 10% 8% 30%;
  border-radius: 50%;
  background: var(--game-glow);
  filter: blur(8px);
  opacity: 0.9;
}

.pointer-art,
.pointer-art svg,
.spin-button-icon,
.spin-button-icon svg {
  display: block;
  width: 100%;
  height: 100%;
}

.seasonal-game.is-spinning .pointer {
  animation: sg-pointer-tick 0.22s ease-in-out infinite;
}

.seasonal-game.is-landed .pointer {
  animation: sg-pointer-land 0.45s ease;
}

.spin-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 168px;
  min-height: 50px;
  padding: 12px 28px;
  border: none;
  border-radius: 999px;
  color: var(--game-button-text);
  background: linear-gradient(180deg, color-mix(in srgb, var(--game-accent) 88%, #fff), var(--game-accent));
  box-shadow:
    0 6px 0 color-mix(in srgb, var(--game-accent) 55%, #000),
    0 12px 24px rgba(0, 0, 0, 0.22);
  font: inherit;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.12em;
  cursor: pointer;
  transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
}

.spin-button-icon {
  width: 22px;
  height: 22px;
}

.spin-button:hover:not(:disabled) {
  filter: brightness(1.08);
  transform: translateY(-2px);
}

.spin-button:active:not(:disabled) {
  transform: translateY(3px);
  box-shadow:
    0 2px 0 color-mix(in srgb, var(--game-accent) 55%, #000),
    0 8px 16px rgba(0, 0, 0, 0.18);
}

.spin-button:focus-visible {
  outline: 3px solid var(--game-accent);
  outline-offset: 4px;
}

.spin-button:disabled {
  cursor: not-allowed;
  opacity: 0.7;
  filter: grayscale(0.15);
}

.wheel-empty-state {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
}

.sg-particle {
  position: absolute;
  left: var(--x);
  top: var(--y);
  width: var(--size, 18px);
  height: var(--size, 18px);
  color: var(--game-accent);
  opacity: 0.85;
  animation: sg-drift var(--dur, 9s) linear infinite;
  animation-delay: var(--delay, 0s);
}

.sg-particle svg {
  width: 100%;
  height: 100%;
}

.sg-result {
  position: absolute;
  inset: 0;
  z-index: 8;
  display: grid;
  place-items: center;
  padding: 16px;
}

.sg-result[hidden] {
  display: none;
}

.sg-result-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(6, 4, 10, 0.55);
  backdrop-filter: blur(6px);
}

.sg-result-card {
  position: relative;
  z-index: 1;
  width: min(100%, 340px);
  overflow: hidden;
  padding: 28px 22px 22px;
  border-radius: 22px;
  background: color-mix(in srgb, var(--game-bg) 88%, #000);
  border: 1px solid color-mix(in srgb, var(--game-accent) 50%, transparent);
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.4);
  animation: sg-pop 0.45s cubic-bezier(0.2, 1.2, 0.3, 1);
}

.sg-result-card.is-win {
  background:
    radial-gradient(circle at 50% 0%, var(--game-glow), transparent 55%),
    color-mix(in srgb, var(--game-bg) 86%, #000);
}

.sg-result-card.is-miss {
  animation: sg-miss 0.5s ease;
}

.sg-result-fx {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.sg-burst {
  position: absolute;
  left: 50%;
  top: 28%;
  width: 10px;
  height: 10px;
  margin: -5px;
  border-radius: 50%;
  background: var(--game-accent);
  animation: sg-burst 1.1s ease-out forwards;
}

.sg-result-eyebrow {
  margin: 0 0 6px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--game-accent);
}

.sg-result-title {
  margin: 0 0 8px;
  font-size: 28px;
  line-height: 1.15;
}

.sg-result-reward {
  margin: 0 0 16px;
  font-size: 16px;
  color: var(--game-muted);
}

.sg-result-code-label {
  display: block;
  margin-bottom: 8px;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.75;
}

.sg-result-code-row {
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.sg-result-code-value {
  display: block;
  min-width: 0;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.08);
  font-size: 13px;
  word-break: break-all;
}

.sg-copy,
.sg-result-close {
  border: none;
  cursor: pointer;
  font: inherit;
  font-weight: 800;
}

.sg-copy {
  flex: 0 0 auto;
  padding: 10px 12px;
  border-radius: 10px;
  color: var(--game-button-text);
  background: var(--game-accent);
}

.sg-result-hint {
  margin: 0 0 16px;
  font-size: 13px;
  color: var(--game-muted);
}

.sg-result-close {
  width: 100%;
  min-height: 46px;
  border-radius: 999px;
  color: var(--game-text);
  background: transparent;
  border: 1px solid color-mix(in srgb, var(--game-accent) 50%, transparent);
}

/* Halloween */
.seasonal-game[data-theme="halloween"] {
  --game-bg: #16091c;
  --game-bg-2: #4a1d08;
  --game-text: #ffe8c8;
  --game-muted: #efd2a8;
  --game-accent: #ff7a18;
  --game-accent-2: #7a29c7;
  --game-button-text: #1c0b08;
  --game-rim: #2a1018;
  --game-hub: #12060f;
  --game-glow: rgba(255, 122, 24, 0.5);
  box-shadow:
    0 0 0 1px rgba(255, 122, 24, 0.28),
    0 18px 50px rgba(40, 0, 20, 0.45);
}

.seasonal-game[data-theme="halloween"] .wheel {
  border-color: #ff9a3c;
  box-shadow:
    0 0 0 4px #1a050c,
    0 0 24px rgba(255, 90, 0, 0.45),
    inset 0 0 30px rgba(80, 0, 90, 0.35);
}

.seasonal-game[data-theme="halloween"] .wheel-ornaments::before,
.seasonal-game[data-theme="halloween"] .wheel-ornaments::after {
  content: "";
  position: absolute;
  width: 42px;
  height: 42px;
  background:
    radial-gradient(circle at 20% 20%, #fff 1.5px, transparent 2px),
    linear-gradient(#0000, #0000);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-top: 0;
  border-left: 0;
  border-radius: 0 0 70% 0;
  opacity: 0.55;
}

.seasonal-game[data-theme="halloween"] .wheel-ornaments::before {
  top: 8px;
  left: 8px;
}

.seasonal-game[data-theme="halloween"] .wheel-ornaments::after {
  right: 10px;
  bottom: 16px;
  transform: rotate(180deg);
}

.seasonal-game[data-theme="halloween"].is-win-fx {
  animation: sg-haunt 0.8s ease;
}

/* Christmas */
.seasonal-game[data-theme="christmas"] {
  --game-bg: #0d2a1f;
  --game-bg-2: #7a1520;
  --game-text: #fff7ea;
  --game-muted: #d7ecdc;
  --game-accent: #e03131;
  --game-accent-2: #f4d35e;
  --game-button-text: #fff;
  --game-rim: #f0e2b6;
  --game-hub: #123226;
  --game-glow: rgba(255, 255, 255, 0.35);
}

.seasonal-game[data-theme="christmas"] .wheel {
  border-color: #f2d38a;
  box-shadow:
    0 0 0 4px #8b1e2d,
    0 0 0 8px #efefef,
    0 12px 28px rgba(0, 0, 0, 0.3);
}

.seasonal-game[data-theme="christmas"] .sg-particle {
  color: #fff;
  filter: drop-shadow(0 0 4px #fff);
}

/* Diwali */
.seasonal-game[data-theme="diwali"] {
  --game-bg: #4a1028;
  --game-bg-2: #c45c12;
  --game-text: #fff4d8;
  --game-muted: #ffd9a0;
  --game-accent: #ffb703;
  --game-accent-2: #e6396b;
  --game-button-text: #3b1020;
  --game-rim: #ffd27a;
  --game-hub: #5a1230;
  --game-glow: rgba(255, 183, 3, 0.55);
}

.seasonal-game[data-theme="diwali"] .wheel {
  border-color: #ffd27a;
  box-shadow:
    0 0 0 5px #9b1d4a,
    0 0 28px rgba(255, 183, 3, 0.45);
}

.seasonal-game[data-theme="diwali"].is-win-fx .wheel-halo {
  animation: sg-firework-halo 0.9s ease-out;
}

/* Valentine's */
.seasonal-game[data-theme="valentines"] {
  --game-bg: #4a1024;
  --game-bg-2: #ff8fab;
  --game-text: #fff0f5;
  --game-muted: #ffd0de;
  --game-accent: #ff4d6d;
  --game-accent-2: #c9184a;
  --game-button-text: #fff;
  --game-rim: #ffd6e0;
  --game-hub: #5c132c;
  --game-glow: rgba(255, 77, 109, 0.45);
}

.seasonal-game[data-theme="valentines"] .wheel {
  border-color: #ffb3c6;
  box-shadow:
    0 0 0 4px #c9184a,
    0 0 24px rgba(255, 77, 109, 0.4);
}

/* Black Friday */
.seasonal-game[data-theme="black-friday"] {
  --game-bg: #0b0b0d;
  --game-bg-2: #2b2108;
  --game-text: #f5f0e0;
  --game-muted: #d9c98a;
  --game-accent: #f5c518;
  --game-accent-2: #111;
  --game-button-text: #111;
  --game-rim: #f5c518;
  --game-hub: #171717;
  --game-glow: rgba(245, 197, 24, 0.4);
}

.seasonal-game[data-theme="black-friday"] .wheel {
  border-color: #f5c518;
  box-shadow:
    0 0 0 5px #111,
    0 0 20px rgba(245, 197, 24, 0.45);
}

.seasonal-game[data-theme="black-friday"] .sg-badge {
  background: #f5c518;
  color: #111;
  border-color: #f5c518;
}

/* New Year */
.seasonal-game[data-theme="new-year"] {
  --game-bg: #071428;
  --game-bg-2: #3a2a08;
  --game-text: #f7f1dc;
  --game-muted: #d5c48a;
  --game-accent: #e6c35c;
  --game-accent-2: #4cc9f0;
  --game-button-text: #12100a;
  --game-rim: #e6c35c;
  --game-hub: #0b1c33;
  --game-glow: rgba(76, 201, 240, 0.35);
}

.seasonal-game[data-theme="new-year"] .wheel {
  border-color: #e6c35c;
  box-shadow:
    0 0 0 4px #0a2040,
    0 0 30px rgba(76, 201, 240, 0.28);
}

/* Summer */
.seasonal-game[data-theme="summer"] {
  --game-bg: #073b4c;
  --game-bg-2: #ffd166;
  --game-text: #fff8e8;
  --game-muted: #d6f3ff;
  --game-accent: #ff7b54;
  --game-accent-2: #06d6a0;
  --game-button-text: #fff;
  --game-rim: #fff3bf;
  --game-hub: #0a4a60;
  --game-glow: rgba(255, 209, 102, 0.5);
}

.seasonal-game[data-theme="summer"] .wheel {
  border-color: #fff3bf;
  box-shadow:
    0 0 0 5px #118ab2,
    0 10px 24px rgba(7, 59, 76, 0.35);
}

.seasonal-game[data-theme="none"] {
  --game-bg: #17141f;
  --game-bg-2: #3d2b5a;
  --game-accent: #8ce0c2;
  --game-accent-2: #c084fc;
  --game-button-text: #10211b;
  --game-rim: #efe7ff;
  --game-hub: #221a2e;
  --game-glow: rgba(140, 224, 194, 0.4);
}

.seasonal-game[data-theme="christmas"]::before,
.seasonal-game[data-theme="diwali"]::before,
.seasonal-game[data-theme="halloween"]::before,
.seasonal-game[data-theme="summer"]::after,
.seasonal-game[data-theme="new-year"]::before {
  content: "";
  position: absolute;
  pointer-events: none;
  z-index: 1;
}

.seasonal-game[data-theme="christmas"]::before {
  top: 0;
  right: 0;
  left: 0;
  height: 14px;
  background: repeating-linear-gradient(
    90deg,
    #c62828 0 14px,
    #2e7d32 14px 28px,
    #f9a825 28px 42px
  );
}

.seasonal-game[data-theme="halloween"]::before {
  inset: 10px auto auto 12px;
  width: 46px;
  height: 46px;
  background:
    radial-gradient(circle at 50% 20%, #3a7d2c 4px, transparent 5px),
    radial-gradient(circle at 50% 70%, #ff7a18 10px, transparent 11px);
  opacity: 0.9;
}

.seasonal-game[data-theme="diwali"]::before {
  inset: 12px 12px auto auto;
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background:
    repeating-conic-gradient(from 10deg, #ffb703 0 8deg, transparent 8deg 20deg);
  mask: radial-gradient(circle, transparent 42%, #000 43% 62%, transparent 63%);
  opacity: 0.85;
}

.seasonal-game[data-theme="new-year"]::before {
  top: 10px;
  right: 16px;
  width: 70px;
  height: 18px;
  border-radius: 999px;
  background: linear-gradient(90deg, #e6c35c, #4cc9f0);
  opacity: 0.8;
}

.seasonal-game[data-theme="summer"]::after {
  right: 0;
  bottom: 0;
  left: 0;
  height: 28px;
  background:
    radial-gradient(circle at 20% 0, #06d6a0 12px, transparent 13px),
    radial-gradient(circle at 50% 8px, #118ab2 16px, transparent 17px),
    radial-gradient(circle at 80% 0, #ffd166 14px, transparent 15px);
  opacity: 0.7;
}

@keyframes sg-halo {
  0%, 100% { opacity: 0.55; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.04); }
}

@keyframes sg-pointer-tick {
  0%, 100% { transform: translateX(-50%) rotate(-7deg); }
  50% { transform: translateX(-50%) rotate(8deg); }
}

@keyframes sg-pointer-land {
  0% { transform: translateX(-50%) rotate(-12deg); }
  40% { transform: translateX(-50%) rotate(9deg); }
  100% { transform: translateX(-50%) rotate(0deg); }
}

@keyframes sg-drift {
  0% { transform: translate3d(0, 20px, 0) rotate(0deg); opacity: 0; }
  12% { opacity: 0.85; }
  100% { transform: translate3d(var(--drift, 18px), -140px, 0) rotate(220deg); opacity: 0; }
}

@keyframes sg-pop {
  from { transform: scale(0.86) translateY(12px); opacity: 0; }
  to { transform: scale(1) translateY(0); opacity: 1; }
}

@keyframes sg-miss {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-6px); }
  40% { transform: translateX(6px); }
  60% { transform: translateX(-4px); }
}

@keyframes sg-burst {
  to {
    transform: translate(var(--tx), var(--ty)) scale(0.2);
    opacity: 0;
  }
}

@keyframes sg-haunt {
  0%, 100% { filter: none; }
  30% { filter: saturate(1.4) hue-rotate(-10deg); }
  55% { filter: brightness(1.15); }
}

@keyframes sg-firework-halo {
  0% { transform: scale(0.8); opacity: 0.3; }
  100% { transform: scale(1.4); opacity: 0; }
}

@media (max-width: 480px) {
  .seasonal-game {
    padding: 20px 14px 22px;
    border-radius: 22px;
  }

  .wheel-container {
    width: min(264px, 86vw);
    margin: 22px auto 24px;
  }

  .pointer {
    --pointer-size: 50px;
    top: -26px;
  }

  .wheel-label {
    width: 62px;
    font-size: 11px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .wheel,
  .spin-button,
  .sg-particle,
  .pointer,
  .wheel-halo,
  .sg-result-card,
  .sg-burst {
    animation: none !important;
    transition: none !important;
  }
}
</style>

<script>
(() => {
  const root = document.getElementById("seasonal-game-{{ block.id }}");
  if (!root) return;

  const wheel = root.querySelector(".wheel");
  const spinButton = root.querySelector(".spin-button");
  const spinLabel = root.querySelector(".spin-button-label");
  const spinIcon = root.querySelector(".spin-button-icon");
  const pointerArt = root.querySelector(".pointer-art");
  const hub = root.querySelector(".wheel-hub");
  const atmosphere = root.querySelector(".sg-atmosphere");
  const badge = root.querySelector(".sg-badge");
  const title = root.querySelector(".sg-header h2");
  const subtitle = root.querySelector(".sg-subtitle");
  const resultRoot = root.querySelector(".sg-result");
  const resultCard = root.querySelector(".sg-result-card");
  const resultFx = root.querySelector(".sg-result-fx");
  const resultEyebrow = root.querySelector(".sg-result-eyebrow");
  const resultTitle = root.querySelector(".sg-result-title");
  const resultReward = root.querySelector(".sg-result-reward");
  const resultHint = root.querySelector(".sg-result-hint");
  const resultCodeWrap = root.querySelector(".sg-result-code");
  const resultCodeValue = root.querySelector(".sg-result-code-value");
  const copyButton = root.querySelector(".sg-copy");
  const closeButton = root.querySelector(".sg-result-close");

  const svg = {
    pumpkin: `<svg viewBox="0 0 64 80" fill="none"><path d="M30 8c0-4 4-7 8-6 1 6-3 9-8 9V8Z" fill="#3a7d2c"/><path d="M32 14c-14 2-24 16-24 30 0 16 11 26 24 26s24-10 24-26c0-14-10-28-24-30Z" fill="#ff7a18"/><path d="M32 16c-5 10-6 22-6 30 0 8 1 16 6 22 5-6 6-14 6-22 0-8-1-20-6-30Z" fill="#ff9a3c"/><path d="M24 36l-6 5 6 2 4-6Zm16 0 6 5-6 2-4-6ZM26 52c4 5 8 5 12 0" stroke="#3b1408" stroke-width="2.4" stroke-linecap="round"/><path d="M22 72h20l-10 8-10-8Z" fill="#ff7a18"/></svg>`,
    rocket: `<svg viewBox="0 0 64 88" fill="none"><path d="M32 86c12-16 14-28 14-40 0-18-8-32-14-40C26 14 18 28 18 46c0 12 2 24 14 40Z" fill="#ff4d6d"/><path d="M32 12c-4 8-8 20-8 34 0 10 2 20 8 32 6-12 8-22 8-32 0-14-4-26-8-34Z" fill="#ffd166"/><circle cx="32" cy="40" r="6" fill="#3b1020"/><path d="M18 50l-10 14 16-6m22-8 10 14-16-6" fill="#f77f00"/><path d="M26 8h12l-6-8-6 8Z" fill="#fff3bf"/><path d="M28 78c2 6 4 8 4 8s2-2 4-8h-8Z" fill="#ffb703"/></svg>`,
    star: `<svg viewBox="0 0 64 80" fill="none"><path d="M32 4l7 18 20 2-15 13 5 19-17-10-17 10 5-19L5 24l20-2 7-18Z" fill="#f4d35e" stroke="#fff6d2" stroke-width="2"/><path d="M26 70h12l-6 10-6-10Z" fill="#e03131"/></svg>`,
    cane: `<svg viewBox="0 0 64 84" fill="none"><path d="M44 18c0-10-8-16-18-16S8 8 8 18s8 16 18 16h4v42c0 4 4 8 8 8s8-4 8-8V18Z" fill="#fff"/><path d="M14 16c0-6 5-10 12-10v8c-3 0-4 1-4 2h-8Zm22 2h8v12h-8zm0 20h8v12h-8zm0 20h8v14c0 1-1 2-2 2h-6V58Z" fill="#e03131"/></svg>`,
    heart: `<svg viewBox="0 0 64 80" fill="none"><path d="M32 28c4-12 20-14 24-4 4 10-4 18-24 36C12 42 4 34 8 24c4-10 20-8 24 4Z" fill="#ff4d6d" stroke="#fff0f5" stroke-width="2"/><path d="M24 70h16l-8 10-8-10Z" fill="#c9184a"/></svg>`,
    bolt: `<svg viewBox="0 0 64 84" fill="none"><path d="M38 4 16 40h16L20 80l34-44H36L50 4H38Z" fill="#f5c518" stroke="#111" stroke-width="3"/></svg>`,
    sparkler: `<svg viewBox="0 0 64 88" fill="none"><path d="M32 40 18 8l14 10L46 4 36 22l18 2-16 10 12 16-16-8-2 20-8-18-18 8 14-16L8 24l18 4 6-28Z" fill="#e6c35c"/><path d="M30 52h4v36h-4z" fill="#d9c48a"/><circle cx="32" cy="40" r="6" fill="#4cc9f0"/></svg>`,
    sun: `<svg viewBox="0 0 64 84" fill="none"><circle cx="32" cy="32" r="14" fill="#ffd166"/><path d="M32 4v8M32 52v8M10 32h8M46 32h8M14 14l6 6M44 44l6 6M14 50l6-6M44 20l6-6" stroke="#ff7b54" stroke-width="4" stroke-linecap="round"/><path d="M24 70h16l-8 10-8-10Z" fill="#ff7b54"/></svg>`,
    jewel: `<svg viewBox="0 0 64 80" fill="none"><path d="M32 6 8 28l24 46 24-46L32 6Z" fill="#8ce0c2" stroke="#efe7ff" stroke-width="3"/><path d="M32 6 20 28h24L32 6Z" fill="#c084fc"/></svg>`,
    moon: `<svg viewBox="0 0 32 32" fill="none"><path d="M20 6a12 12 0 1 0 6 20 10 10 0 1 1-6-20Z" fill="currentColor"/></svg>`,
    tree: `<svg viewBox="0 0 32 32" fill="none"><path d="M16 4 6 16h6L6 24h20l-6-8h6L16 4Z" fill="#3fa34d"/><path d="M14 24h4v6h-4z" fill="#b08968"/><circle cx="16" cy="12" r="2" fill="#e03131"/></svg>`,
    diya: `<svg viewBox="0 0 32 32" fill="none"><path d="M8 20c0 6 16 6 16 0H8Z" fill="#ffb703"/><path d="M16 8c4 6 2 10 0 12-2-2-4-6 0-12Z" fill="#ff7b54"/></svg>`,
    rose: `<svg viewBox="0 0 32 32" fill="none"><path d="M16 28s10-6 10-14-10-12-10-4C16 2 6 6 6 14s10 14 10 14Z" fill="currentColor"/></svg>`,
    tag: `<svg viewBox="0 0 32 32" fill="none"><path d="M4 16 16 4h12v12L16 28 4 16Z" fill="currentColor"/><circle cx="22" cy="10" r="2" fill="#111"/></svg>`,
    glass: `<svg viewBox="0 0 32 32" fill="none"><path d="M10 4h12l-2 10c0 4-2 6-4 6s-4-2-4-6L10 4Z" fill="currentColor"/><path d="M15 20h2v8h-2z" fill="currentColor"/></svg>`,
    wave: `<svg viewBox="0 0 32 32" fill="none"><path d="M4 18c4 0 4-4 8-4s4 4 8 4 4-4 8-4v8H4v-4Z" fill="currentColor"/></svg>`,
    bat: `<svg viewBox="0 0 32 20" fill="none"><path d="M16 12c-2-8-8-10-14-8 4 4 4 8 2 12 6-2 8 2 12 2s6-4 12-2c-2-4-2-8 2-12-6-2-12 0-14 8Z" fill="currentColor"/></svg>`,
    flake: `<svg viewBox="0 0 24 24" fill="none"><path d="M12 2v20M4 6l16 12M4 18 20 6M2 12h20" stroke="currentColor" stroke-width="2"/></svg>`,
    spark: `<svg viewBox="0 0 24 24" fill="none"><path d="M12 2 9 9 2 12l7 3 3 7 3-7 7-3-7-3-3-7Z" fill="currentColor"/></svg>`,
  };

  const themePacks = {
    halloween: {
      title: "Trick or Treat!",
      subtitle: "Give the haunted wheel a spin before midnight.",
      badge: "Spooky carnival",
      spin: "SPIN",
      spinning: "HAUNTING…",
      pointer: "pumpkin",
      hub: "moon",
      icon: "pumpkin",
      particle: "bat",
      particleCount: 9,
      winEyebrow: "The spirits smile",
      winTitle: "Boo-yah!",
      loseEyebrow: "A ghostly hush",
      loseTitle: "Not this haunt",
      loseHint: "The cauldron needs another stir.",
      colors: ["#ff7a18", "#6a0dad", "#1a1a1a", "#ffb347", "#7b2cbf"],
    },
    christmas: {
      title: "Holiday Spin!",
      subtitle: "A festive whirl of gifts, gold, and snow.",
      badge: "North Pole special",
      spin: "SPIN",
      spinning: "JINGLING…",
      pointer: "star",
      hub: "tree",
      icon: "cane",
      particle: "flake",
      particleCount: 14,
      winEyebrow: "Merry and bright",
      winTitle: "You got a gift!",
      loseEyebrow: "Snowed under",
      loseTitle: "Coal this round",
      loseHint: "Shake the snow globe and try again.",
      colors: ["#c62828", "#2e7d32", "#f9a825", "#f4f1de", "#8e0000"],
    },
    diwali: {
      title: "Festival of Lights",
      subtitle: "Send a rocket spinning for a glowing reward.",
      badge: "Shubh Deepavali",
      spin: "SPIN",
      spinning: "IGNITING…",
      pointer: "rocket",
      hub: "diya",
      icon: "spark",
      particle: "spark",
      particleCount: 12,
      winEyebrow: "Diwali ki shubhkamnayein",
      winTitle: "A bright win!",
      loseEyebrow: "A quiet spark",
      loseTitle: "The rocket fizzled",
      loseHint: "Light another diya and spin again.",
      colors: ["#ff6f00", "#d81b60", "#ffc107", "#6a1b9a", "#f4511e"],
    },
    valentines: {
      title: "Lucky in Love",
      subtitle: "Let Cupid’s wheel choose a sweet surprise.",
      badge: "Be mine",
      spin: "SPIN",
      spinning: "SWOONING…",
      pointer: "heart",
      hub: "rose",
      icon: "heart",
      particle: "heart",
      particleCount: 10,
      winEyebrow: "Heart eyes",
      winTitle: "You won, darling!",
      loseEyebrow: "Almost a crush",
      loseTitle: "Not this valentine",
      loseHint: "Love takes another spin.",
      colors: ["#ff4d6d", "#c9184a", "#ffb3c6", "#ff8fab", "#590d22"],
    },
    "black-friday": {
      title: "Midnight Deals",
      subtitle: "Lock in a limited drop before it vanishes.",
      badge: "Black Friday",
      spin: "SPIN",
      spinning: "CHECKOUT…",
      pointer: "bolt",
      hub: "tag",
      icon: "bolt",
      particle: "spark",
      particleCount: 8,
      winEyebrow: "Deal unlocked",
      winTitle: "You scored!",
      loseEyebrow: "Sold out vibe",
      loseTitle: "Missed this drop",
      loseHint: "The next doorbuster is one spin away.",
      colors: ["#111111", "#f5c518", "#3a3a3a", "#d9d9d9", "#7a5c00"],
    },
    "new-year": {
      title: "Countdown Spin",
      subtitle: "Toast the year with a sparkling prize.",
      badge: "Happy New Year",
      spin: "SPIN",
      spinning: "5… 4… 3…",
      pointer: "sparkler",
      hub: "glass",
      icon: "sparkler",
      particle: "spark",
      particleCount: 12,
      winEyebrow: "Auld lang syne",
      winTitle: "Midnight magic!",
      loseEyebrow: "Before the ball drops",
      loseTitle: "Try the next toast",
      loseHint: "The countdown continues.",
      colors: ["#0b1c33", "#e6c35c", "#4cc9f0", "#f8f1d0", "#274060"],
    },
    summer: {
      title: "Sunshine Spin",
      subtitle: "Catch a summer splash of savings.",
      badge: "Heatwave sale",
      spin: "SPIN",
      spinning: "SURFING…",
      pointer: "sun",
      hub: "wave",
      icon: "sun",
      particle: "spark",
      particleCount: 9,
      winEyebrow: "Beach day",
      winTitle: "You caught a wave!",
      loseEyebrow: "Low tide",
      loseTitle: "Missed the swell",
      loseHint: "Paddle out and spin again.",
      colors: ["#118ab2", "#ff7b54", "#ffd166", "#06d6a0", "#073b4c"],
    },
    none: {
      title: "Spin & Win!",
      subtitle: "Give the wheel a whirl to reveal your reward.",
      badge: "Seasonal Games",
      spin: "SPIN",
      spinning: "SPINNING…",
      pointer: "jewel",
      hub: "spark",
      icon: "jewel",
      particle: "spark",
      particleCount: 8,
      winEyebrow: "Nice one",
      winTitle: "You won!",
      loseEyebrow: "So close",
      loseTitle: "Try again",
      loseHint: "The next spin could be yours.",
      colors: ["#8ce0c2", "#c084fc", "#f0abfc", "#38bdf8", "#1e1b4b"],
    },
  };

  let rewards = [];
  let colors = themePacks.none.colors;
  let currentTheme = "none";
  let spinning = false;
  let currentRotation = 0;
  let pendingSpinKey = null;
  let lastCode = "";
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function packFor(theme) {
    const key = String(theme || "none").toLowerCase().replace(/_/g, "-");
    const aliases = {
      valentine: "valentines",
      "valentines-day": "valentines",
      blackfriday: "black-friday",
      newyear: "new-year",
      "new-years": "new-year",
    };
    const resolved = aliases[key] || key;
    if (themePacks[resolved]) return { name: resolved, pack: themePacks[resolved] };
    return {
      name: "none",
      pack: {
        ...themePacks.none,
        title: "Spin & Win!",
        badge: "Seasonal treat",
      },
    };
  }

  function applyTheme(theme) {
    const { name, pack } = packFor(theme);
    currentTheme = name;
    colors = pack.colors;
    root.dataset.theme = name;
    badge.textContent = pack.badge;
    title.textContent = pack.title;
    subtitle.textContent = pack.subtitle;
    spinLabel.textContent = pack.spin;
    pointerArt.innerHTML = svg[pack.pointer] || svg.jewel;
    hub.innerHTML = svg[pack.hub] || svg.spark;
    spinIcon.innerHTML = svg[pack.icon] || svg.jewel;
    buildAtmosphere(pack);
  }

  function buildAtmosphere(pack) {
    atmosphere.replaceChildren();
    if (reduceMotion) return;
    const count = pack.particleCount || 8;
    for (let i = 0; i < count; i += 1) {
      const particle = document.createElement("span");
      particle.className = "sg-particle";
      particle.style.setProperty("--x", `${8 + ((i * 37) % 84)}%`);
      particle.style.setProperty("--y", `${70 + ((i * 13) % 40)}%`);
      particle.style.setProperty("--size", `${12 + (i % 5) * 4}px`);
      particle.style.setProperty("--dur", `${7 + (i % 6)}s`);
      particle.style.setProperty("--delay", `${(i * 0.4) % 5}s`);
      particle.style.setProperty("--drift", `${(i % 2 === 0 ? 16 : -18)}px`);
      particle.innerHTML = svg[pack.particle] || svg.spark;
      atmosphere.appendChild(particle);
    }
  }

  function contrastColor(hex) {
    const value = hex.replace("#", "");
    const r = parseInt(value.slice(0, 2), 16);
    const g = parseInt(value.slice(2, 4), 16);
    const b = parseInt(value.slice(4, 6), 16);
    const yiq = (r * 299 + g * 587 + b * 114) / 1000;
    return yiq > 160 ? "#1a1a1a" : "#ffffff";
  }

  function showEmpty(message) {
    wheel.replaceChildren();
    const empty = document.createElement("div");
    empty.className = "wheel-empty-state";
    empty.textContent = message;
    wheel.appendChild(empty);
    spinButton.disabled = true;
  }

  async function loadCampaign() {
    try {
      const response = await fetch("/apps/seasonal-games");
      if (!response.ok) throw new Error(`Request failed: ${response.status}`);
      const data = await response.json();
      if (!data.campaign || !data.campaign.rewards.length) {
        showEmpty("No active campaigns");
        return;
      }
      applyTheme(data.campaign.theme);
      rewards = data.campaign.rewards;
      buildWheel();
    } catch (error) {
      showEmpty("No active campaigns");
    }
  }

  function buildWheel() {
    const sliceAngle = 360 / rewards.length;
    const gradientStops = rewards.map((reward, index) => {
      const start = index * sliceAngle;
      const end = (index + 1) * sliceAngle;
      const color = colors[index % colors.length];
      return `${color} ${start}deg ${end}deg`;
    });

    wheel.style.setProperty("--wheel-gradient", gradientStops.join(", "));
    wheel.replaceChildren();

    rewards.forEach((reward, index) => {
      const label = document.createElement("div");
      label.className = "wheel-label";
      label.textContent = reward;
      const start = 270 + index * sliceAngle;
      const angle = start + sliceAngle / 2;
      const radius = Math.min(55, 150 * Math.sin(Math.PI / rewards.length) * 0.65);
      label.style.color = contrastColor(colors[index % colors.length]);
      label.style.transform = `rotate(${angle}deg) translateX(${radius}px) translateY(-50%)`;
      wheel.appendChild(label);
    });
  }

  function burst(kind) {
    resultFx.replaceChildren();
    if (reduceMotion) return;
    const count = kind === "win" ? 22 : 8;
    for (let i = 0; i < count; i += 1) {
      const spec = document.createElement("span");
      spec.className = "sg-burst";
      const angle = (Math.PI * 2 * i) / count;
      const dist = kind === "win" ? 90 + (i % 5) * 16 : 36;
      spec.style.setProperty("--tx", `${Math.cos(angle) * dist}px`);
      spec.style.setProperty("--ty", `${Math.sin(angle) * dist}px`);
      spec.style.background = i % 2 === 0 ? "var(--game-accent)" : "var(--game-accent-2)";
      spec.style.animationDelay = `${i * 0.02}s`;
      resultFx.appendChild(spec);
    }
  }

  function showResult({ reward, code, error }) {
    const pack = packFor(currentTheme).pack;
    const isWin = Boolean(code);
    resultCard.classList.toggle("is-win", isWin);
    resultCard.classList.toggle("is-miss", !isWin && !error);
    root.classList.toggle("is-win-fx", isWin);

    if (error) {
      resultEyebrow.textContent = "Hold on";
      resultTitle.textContent = "Spin paused";
      resultReward.textContent = error;
      resultHint.textContent = "You can try again in a moment.";
      resultCodeWrap.hidden = true;
      closeButton.textContent = "Try again";
      burst("miss");
    } else if (isWin) {
      resultEyebrow.textContent = pack.winEyebrow;
      resultTitle.textContent = pack.winTitle;
      resultReward.textContent = `You won: ${reward}`;
      resultHint.textContent = "Copy the code and apply it at checkout.";
      resultCodeValue.textContent = code;
      resultCodeWrap.hidden = false;
      lastCode = code;
      copyButton.textContent = "Copy";
      closeButton.textContent = "Awesome";
      burst("win");
    } else {
      resultEyebrow.textContent = pack.loseEyebrow;
      resultTitle.textContent = pack.loseTitle;
      resultReward.textContent = reward || "Try again";
      resultHint.textContent = pack.loseHint;
      resultCodeWrap.hidden = true;
      closeButton.textContent = "Spin again";
      burst("miss");
    }

    resultRoot.hidden = false;
    closeButton.focus();
  }

  function hideResult() {
    resultRoot.hidden = true;
    root.classList.remove("is-win-fx", "is-landed");
    wheel.style.transition = "none";
    wheel.style.transform = "rotate(0deg)";
    currentRotation = 0;
  }

  copyButton.addEventListener("click", async () => {
    if (!lastCode) return;
    try {
      await navigator.clipboard.writeText(lastCode);
      copyButton.textContent = "Copied";
    } catch (error) {
      copyButton.textContent = "Copy failed";
    }
  });

  closeButton.addEventListener("click", () => {
    hideResult();
    spinning = false;
    spinButton.disabled = false;
    spinLabel.textContent = packFor(currentTheme).pack.spin;
  });

  spinButton.addEventListener("click", async () => {
    if (spinning || rewards.length === 0) return;

    spinning = true;
    spinButton.disabled = true;
    root.classList.add("is-spinning");
    spinLabel.textContent = packFor(currentTheme).pack.spinning;

    try {
      if (!pendingSpinKey) pendingSpinKey = crypto.randomUUID();

      const response = await fetch("/apps/seasonal-games/discount", {
        method: "POST",
        headers: {
          Accept: "application/json",
          "Idempotency-Key": pendingSpinKey,
        },
      });

      const result = await response.json();
      if (!response.ok) throw new Error(result.error || "Could not process your spin.");

      const winningIndex = result.position;
      if (
        !Number.isInteger(winningIndex) ||
        winningIndex < 0 ||
        winningIndex >= rewards.length
      ) {
        throw new Error("The server returned an invalid reward position.");
      }

      pendingSpinKey = null;

      const sliceAngle = 360 / rewards.length;
      const extraSpins = 4;
      const targetAngle =
        (rewards.length - winningIndex - 1) * sliceAngle + sliceAngle / 2;
      currentRotation = extraSpins * 360 + targetAngle;
      const duration = reduceMotion ? 400 : 4000;

      wheel.style.transition = `transform ${duration}ms cubic-bezier(0.12, 0.7, 0.18, 1)`;
      wheel.style.transform = `rotate(${currentRotation}deg)`;

      window.setTimeout(() => {
        root.classList.remove("is-spinning");
        root.classList.add("is-landed");
        showResult({
          reward: result.reward,
          code: result.code,
        });
      }, duration);
    } catch (error) {
      console.error("Spin failed:", error);
      root.classList.remove("is-spinning");
      showResult({
        error: error instanceof Error ? error.message : "Something went wrong. Please try again.",
      });
    }
  });

  applyTheme("none");
  loadCampaign();
})();
</script>

