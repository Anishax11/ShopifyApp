<div class="seasonal-game">
    <h2> Spin & Win!</h2>
    <p>Spin the wheel to reveal your reward.</p>
  
    <div class="wheel-container">
      <div class="pointer">▼</div>
  
      <div class="wheel">
        
      </div>
    </div>
  
    <button type="button" class="spin-button">
      SPIN
    </button>
  </div>
  
  <style>
    
/* Main game card */
.seasonal-game {
  --game-bg: #ffffff;
  --game-text: #222222;
  --game-accent: #ff7518;
  --game-button-text: #ffffff;

  box-sizing: border-box;
  width: 100%;
  max-width: 460px;
  margin: 0 auto;
  padding: clamp(20px, 5vw, 32px);
  text-align: center;
  color: var(--game-text);
  background: var(--game-bg);
  border: 1px solid rgba(128, 128, 128, 0.18);
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

.seasonal-game *,
.seasonal-game *::before,
.seasonal-game *::after {
  box-sizing: border-box;
}

.seasonal-game h2 {
  margin: 0 0 10px;
  font-size: clamp(24px, 5vw, 30px);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.5px;
}

.seasonal-game > p {
  margin: 0;
  font-size: 15px;
  line-height: 1.6;
  opacity: 0.85;
}

/* Wheel and pointer */
.wheel-container {
  position: relative;
  width: min(300px, 100%);
  aspect-ratio: 1;
  margin: 32px auto;
}

.wheel {
  position: relative;
  width: 100%;
  height: 100%;
  border: 6px solid #ffffff;
  border-radius: 50%;
  background: conic-gradient(var(--wheel-gradient));
  box-shadow:
    0 0 0 2px rgba(0, 0, 0, 0.14),
    0 8px 18px rgba(0, 0, 0, 0.18);
  transition: transform 4s ease-out;
  will-change: transform;
}

.wheel-label {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 68px;
  text-align: center;
  transform-origin: 0 0;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.2;
  overflow-wrap: break-word;
  word-break: normal;
}

.pointer {
  position: absolute;
  z-index: 2;
  top: -17px;
  left: 50%;
  transform: translateX(-50%);
  color: var(--game-accent);
  font-size: 32px;
  line-height: 1;
  filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.2));
}

/* Spin button */
.spin-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 160px;
  min-height: 48px;
  padding: 13px 32px;
  border: none;
  border-radius: 999px;
  color: var(--game-button-text);
  background: var(--game-accent);
  box-shadow: 0 5px 0 rgba(0, 0, 0, 0.16);
  font: inherit;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 1px;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    filter 0.2s ease,
    box-shadow 0.2s ease;
}

.spin-button:hover:not(:disabled) {
  filter: brightness(1.08);
  transform: translateY(-2px);
  box-shadow: 0 7px 0 rgba(0, 0, 0, 0.16);
}

.spin-button:active:not(:disabled) {
  transform: translateY(2px);
  box-shadow: 0 2px 0 rgba(0, 0, 0, 0.16);
}

.spin-button:focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 4px;
}

.spin-button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
  filter: grayscale(0.2);
}

/* Empty campaign state */
.wheel-empty-state {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  text-align: center;
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
}

/* Halloween */
.seasonal-game[data-theme="halloween"] {
  --game-bg: #21152b;
  --game-text: #ffffff;
  --game-accent: #ff7518;
  --game-button-text: #ffffff;
  border-color: rgba(255, 117, 24, 0.3);
}

/* Christmas */
.seasonal-game[data-theme="christmas"] {
  --game-bg: #153b2a;
  --game-text: #ffffff;
  --game-accent: #c62828;
  --game-button-text: #ffffff;
}

/* Diwali */
.seasonal-game[data-theme="diwali"] {
  --game-bg: #fff0d1;
  --game-text: #4a1535;
  --game-accent: #d81b60;
  --game-button-text: #ffffff;
}

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {
  .wheel,
  .spin-button {
    transition: none;
  }
}

  </style>

  <script>
    const wheel = document.querySelector(".wheel");
    const spinButton = document.querySelector(".spin-button");
    let rewards = [];
    const themePalettes = {
      halloween: [
        "#ff7518", "#6a0dad", "#222222",
        "#ffb347", "#9932cc"
      ],
      christmas: [
        "#c62828", "#2e7d32", "#f9a825",
        "#ffffff", "#8e0000"
      ],
      diwali: [
        "#ff6f00", "#d81b60", "#ffc107",
        "#6a1b9a", "#f4511e"
      ]
    };

    function applyTheme(theme) {
      const selectedTheme = themePalettes[theme?.toLowerCase()]
        ? theme.toLowerCase()
        : "halloween";
    
      colors = themePalettes[selectedTheme];
    
      document.querySelector(".seasonal-game")
        .dataset.theme = selectedTheme;
    }
    
    let colors = themePalettes.halloween; //default
    let spinning = false;
    
    
    async function loadCampaign() {
      try {
        const response = await fetch("/apps/seasonal-games");    
        if (!response.ok) {
          throw new Error(`Request failed: ${response.status}`);
        }
    
        const data = await response.json();
    
        if (!data.campaign || !data.campaign.rewards.length) {
            wheel.replaceChildren();
            const message = document.createElement("div");
            message.className = "wheel-empty-state";
            message.textContent = "No active campaigns";
            wheel.appendChild(message);
            spinButton.disabled = true;
            return;
          }
        applyTheme(data.campaign.theme);
    
        rewards = data.campaign.rewards;
        buildWheel();
      } catch (error) {
        wheel.replaceChildren();
        const message = document.createElement("div");
        message.className = "wheel-empty-state";
        message.textContent = "No active campaigns";
        wheel.appendChild(message);
        spinButton.disabled = true;
      }
    }
    
    function buildWheel() {
      const sliceAngle = 360 / rewards.length;
    
      // Create one colored slice for each reward.
      const gradientStops = rewards.map((reward, index) => {
        const start = index * sliceAngle;
        const end = (index + 1)*sliceAngle;
        const color = colors[index % colors.length];
    
        return `${color} ${start}deg ${end}deg`;
      });
    
      wheel.style.setProperty(
        "--wheel-gradient",
        gradientStops.join(", ")
      );
    
      // Create one label for each reward.
      wheel.replaceChildren();
    
      rewards.forEach((reward, index) => {
      const label = document.createElement("div");
      label.className = "wheel-label";
      label.textContent = reward;
      const start = 270 + index * sliceAngle;
      const angle = start + sliceAngle/2;
      const radius = Math.min(55, 150 * Math.sin(Math.PI / rewards.length) * 0.65);

      label.style.transform =
        `rotate(${angle}deg) translateX(${radius}px) translateY(-50%)`;
    
      wheel.appendChild(label);
      });
    }
    
let pendingSpinKey = null;

spinButton.addEventListener("click", async () => {
  if (spinning || rewards.length === 0) return;

  spinning = true;
  spinButton.disabled = true;
  

  try {
    // Ask the backend to choose the winning reward.
    // Reuse the same key if this request needs to be retried.
    if (!pendingSpinKey) {
      pendingSpinKey = crypto.randomUUID();
    }

    const response = await fetch("/apps/seasonal-games/discount", {
      method: "POST",
      headers: {
        "Accept": "application/json",
        "Idempotency-Key": pendingSpinKey,
      },
    });

    const result = await response.json();
    

    if (!response.ok) {
      throw new Error(result.error || "Could not process your spin.");
    }
    // The server returned a valid outcome for this request.
    

    const winningIndex = result.position;

    if (
      !Number.isInteger(winningIndex) ||
      winningIndex < 0 ||
      winningIndex >= rewards.length
    ) {
      throw new Error("The server returned an invalid reward position.");
    }

    pendingSpinKey = null;

    // Keep your existing, working rotation formula.
    const sliceAngle = 360 / rewards.length;
    const extraSpins = 4;

    const targetAngle =
      (rewards.length - winningIndex - 1) * sliceAngle +
      (sliceAngle / 2);

    currentRotation = extraSpins * 360 + targetAngle;

    wheel.style.transition = "transform 4s ease-out";
    wheel.style.transform = `rotate(${currentRotation}deg)`;

    // Wait for the animation before showing the result.
    setTimeout(() => {
      const message = result.code
        ? `🎉 You won: ${result.reward}\n\nYour discount code: ${result.code}`
        : `🎉 You won: ${result.reward}`;

      alert(message);

      spinning = false;
      spinButton.disabled = false;

      wheel.style.transition = "none";
      wheel.style.transform = "rotate(0deg)";
      currentRotation = 0;
    }, 4000);
  } catch (error) {
    console.error("Spin failed:", error);

    alert(
      error instanceof Error
        ? error.message
        : "Something went wrong. Please try again.",
    );

    spinning = false;
    spinButton.disabled = false;
  }
});

loadCampaign();


  </script>
  
  {% schema %}
  {
    "name": "Seasonal Game",
    "target": "section",
    "settings": []
  }
  {% endschema %}